# SASPanel — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env to version control.

# -------------------------------------------------------------------
# Flask Core
# -------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_key

# Set to 'production' in production, 'development' for local dev
FLASK_ENV=production

# MUST be 0 in production — exposes interactive debugger if enabled!
FLASK_DEBUG=0

# -------------------------------------------------------------------
# Database (MySQL)
# -------------------------------------------------------------------
DB_HOST=localhost
DB_USER=saspanel_user
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=saspanel

# -------------------------------------------------------------------
# Mail
# -------------------------------------------------------------------
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=support@yourdomain.com
MAIL_PASSWORD=CHANGE_ME_mail_password
MAIL_USE_TLS=true

# -------------------------------------------------------------------
# Rate Limiting
# -------------------------------------------------------------------
# Max login attempts per IP per minute before 429 is returned
LOGIN_RATE_LIMIT=10 per minute
